* {
  box-sizing: border-box;
}

:root {
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --danger: #dc2626;
  --danger-hover: #b91c1c;
  --secondary: #64748b;
  --secondary-hover: #475569;
  --bg-main: #f8fafc;
  --bg-panel: #ffffff;
  --text-main: #1e293b;
  --text-muted: #64748b;
  --border-color: #e2e8f0;
  --radius: 12px;
  --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
}

html,
body {
  margin: 0;
  min-height: 100%;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background: var(--bg-main);
  color: var(--text-main);
}

body {
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

.app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.map-section {
  height: 65vh;
  min-height: 500px;
  width: 100%;
  border-bottom: 1px solid var(--border-color);
}

.map {
  width: 100%;
  height: 100%;
}

.panel {
  background: var(--bg-panel);
  padding: 24px;
  box-shadow: 0 -10px 25px -5px rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 2;
  border-radius: 24px 24px 0 0;
  margin-top: -24px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

h1 {
  margin: 0;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.025em;
  color: var(--text-main);
}

p {
  margin: 4px 0 0;
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 12px;
}

button {
  border: 0;
  border-radius: 8px;
  padding: 10px 16px;
  cursor: pointer;
  font-weight: 500;
  font-size: 14px;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.primary {
  background: var(--primary);
  color: white;
  box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
}

.primary:hover {
  background: var(--primary-hover);
  transform: translateY(-1px);
}

.primary.active {
  background: var(--danger);
  box-shadow: 0 2px 4px rgba(220, 38, 38, 0.2);
}

.primary.active:hover {
  background: var(--danger-hover);
}

.convert-btn {
  background: #f1f5f9;
  color: var(--text-main);
  border: 1px solid var(--border-color);
}

.convert-btn:hover {
  background: #e2e8f0;
  border-color: #cbd5e1;
}

.secondary {
  background: var(--secondary);
  color: white;
}

.secondary:hover {
  background: var(--secondary-hover);
  transform: translateY(-1px);
}

.status {
  margin-bottom: 20px;
  padding: 12px 16px;
  border-radius: var(--radius);
  background: #f8fafc;
  border: 1px solid var(--border-color);
  color: var(--text-muted);
  font-size: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.status-text {
  font-weight: 400;
}

.creation-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
}

.live-stat {
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  background: white;
  padding: 8px 16px;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.live-stat span {
  color: var(--text-muted);
  font-weight: 500;
}

.live-stat strong {
  color: var(--text-main);
  font-weight: 600;
}

.table-wrap {
  margin-top: 10px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  overflow: hidden;
  background: white;
  box-shadow: var(--shadow);
}

table {
  width: 100%;
  min-width: 900px;
  border-collapse: collapse;
  font-size: 13px;
  text-align: left;
}

th {
  background: #f8fafc;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 0.05em;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-color);
}

td {
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  transition: background 0.1s ease;
}

tr:hover td {
  background: #fbfcfe;
}

tr:last-child td {
  border-bottom: 0;
}

.table-text-input,
.table-date-input,
.table-num-input {
  width: 100%;
  height: 100%;
  border: none;
  padding: 12px 16px;
  font-family: inherit;
  font-size: 13px;
  color: var(--text-main);
  background: transparent;
  outline: none;
  transition: all 0.2s ease;
}

.table-text-input:focus,
.table-date-input:focus,
.table-num-input:focus {
  background: #eff6ff;
  box-shadow: inset 0 0 0 2px var(--primary);
}

.delete-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
  background: transparent;
  border: none;
  cursor: pointer;
  font-size: 16px;
}

.delete-btn:hover {
  background: #fee2e2;
  transform: scale(1.1);
}

.empty {
  text-align: center;
  color: var(--text-muted);
  padding: 32px;
  font-style: italic;
}

.setup-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: var(--bg-main);
}

.setup-card {
  max-width: 600px;
  width: 100%;
  background: #fff;
  border-radius: var(--radius);
  padding: 32px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  text-align: center;
}

.setup-card h1 {
  font-size: 24px;
  margin-bottom: 12px;
}

.setup-card code,
.setup-card pre {
  background: #f1f5f9;
  border-radius: 8px;
  padding: 12px;
  font-family: "JetBrains Mono", "Fira Code", monospace;
  font-size: 13px;
}

@media (max-width: 700px) {
  .map-section {
    height: 50vh;
  }
  .panel {
    padding: 16px;
    border-radius: 16px 16px 0 0;
  }
  .header {
    flex-direction: column;
    align-items: flex-start;
  }
  .actions {
    width: 100%;
  }
  .actions button {
    flex: 1;
    justify-content: center;
  }
}
